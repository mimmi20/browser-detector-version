{
  "name": "mimmi20/browser-detector-version",
  "description": "Version Class for the Browser Detector",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "version"
  ],
  "authors": [
    {
      "name": "Thomas Müller",
      "homepage": "https://github.com/mimmi20",
      "role": "Developer"
    },
    {
      "name": "Contributors",
      "homepage": "https://github.com/mimmi20/browser-detector-version/graphs/contributors"
    }
  ],
  "homepage": "https://github.com/mimmi20/browser-detector-version",
  "support": {
    "issues": "https://github.com/mimmi20/browser-detector-version/issues",
    "source": "https://github.com/mimmi20/browser-detector-version"
  },
  "require": {
    "php": "~8.5.0 || ~8.6.0",
    "ext-mbstring": "*",
    "mimmi20/browser-detector-versioninterface": "^2.0.3"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.58.0",
    "infection/infection": "^0.35.12",
    "jbelien/phpstan-sarif-formatter": "^1.2.0",
    "mimmi20/coding-standard": "^8.0.34",
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan": "^2.3.7",
    "phpstan/phpstan-deprecation-rules": "^2.0.5",
    "phpstan/phpstan-phpunit": "^2.1.2",
    "phpunit/phpunit": "^13.4.8",
    "rector/rector": "^2.8.5",
    "shipmonk/composer-dependency-analyser": "^1.8.4",
    "symplify/phpstan-rules": "^14.19.4",
    "tomasvotruba/cognitive-complexity": "^1.3.0",
    "tomasvotruba/type-coverage": "^2.5.1",
    "tomasvotruba/unused-public": "^2.2.1"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "BrowserDetector\\Version\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BrowserDetectorTest\\Version\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true,
      "infection/extension-installer": true,
      "phpstan/extension-installer": true
    },
    "lock": false,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "composer-normalize": {
      "indent-size": 2,
      "indent-style": "space"
    }
  }
}
